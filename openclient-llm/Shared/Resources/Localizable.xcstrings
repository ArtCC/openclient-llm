    "Controls randomness. Higher values make output more creative." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls randomness. Higher values make output more creative."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Styr slumpmässigheten. Högre värden gör resultatet mer kreativt."
          }
        },
