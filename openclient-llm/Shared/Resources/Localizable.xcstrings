    "The request timed out. The server may be slow or unreachable." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストがタイムアウトしました。サーバーが遅いか、接続できません。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La requête a expiré. Le serveur peut être lent ou inaccessible."
