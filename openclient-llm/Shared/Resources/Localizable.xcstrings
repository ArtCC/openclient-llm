            "value" : "Le modèle a terminé de répondre. Touchez pour continuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo terminó de responder. Toca para continuar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
