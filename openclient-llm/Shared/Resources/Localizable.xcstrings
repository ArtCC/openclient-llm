          "stringUnit" : {
            "value" : "Voir vos dernières conversations et y revenir.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dina senaste konversationer och hoppa tillbaka in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の会話を確認してすぐに再開できます"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
