    "Sync could not finish. Your changes remain safely stored on this device." : {
      "comment" : "A description of a failed iCloud sync.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no pudo completarse. Tus cambios permanecen guardados de forma segura en este dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を完了できませんでした。変更内容はこのデバイスに安全に保存されています。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização não pôde ser concluída. As suas alterações permanecem guardadas com segurança neste dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie kon niet worden voltooid. Je wijzigingen zijn veilig opgeslagen op dit apparaat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός δεν ολοκληρώθηκε. Οι αλλαγές σας παραμένουν αποθηκευμένες με ασφάλεια σε αυτή τη συσκευή."
