    "The latest message and its attachments exceed this context window. Increase the context window or shorten the message." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のメッセージと添付ファイルがこのコンテキストウィンドウの容量を超えています。コンテキストウィンドウを拡大するか、メッセージを短くしてください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
