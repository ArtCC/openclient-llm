        "it" : {
          "stringUnit" : {
            "value" : "Sei sicuro di voler eliminare questa conversazione? Questa azione non può essere annullata.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Är du säker på att du vill radera den här konversationen? Denna åtgärd kan inte ångras."
