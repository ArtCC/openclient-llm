    "iCloud is downloading changes. Sync will continue automatically." : {
      "comment" : "A footer for the iCloud sync section.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "iCloud is downloading changes. Sync will continue automatically.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "iCloud tar emot ändringar. Synkroniseringen fortsätter automatiskt.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud está descargando cambios. La sincronización continuará automáticamente."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iCloud λαμβάνει αλλαγές. Ο συγχρονισμός θα συνεχιστεί αυτόματα."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud está a transferir alterações. A sincronização continuará automaticamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "iCloud lädt Änderungen herunter. Die Synchronisierung wird automatisch fortgesetzt.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud télécharge les modifications. La synchronisation se poursuivra automatiquement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is wijzigingen aan het ontvangen. Synchronisatie gaat automatisch door."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sta ricevendo le modifiche. La sincronizzazione continuerà automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudが変更を受信しています。同期は自動的に続行されます。"
          }
        }
      }
    },
