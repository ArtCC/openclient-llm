    "The request timed out. The server may be slow or unreachable." : {
      "localizations" : {
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfrågan tog för lång tid. Servern kan vara långsam eller otillgänglig."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "リクエストがタイムアウトしました。サーバーが遅いか、接続できません。",
