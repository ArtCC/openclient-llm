          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισήχθησαν %1$lld συνομιλίες, αποκαταστάθηκαν %2$lld συνημμένα και παραλείφθηκαν %3$lld συνημμένα."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
