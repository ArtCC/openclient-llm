    "Sync conversations across your devices via iCloud." : {
      "comment" : "A description of the iCloud sync feature.",
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronize conversas entre os seus dispositivos via iCloud."
          }
        },
        "de" : {
