            "state" : "translated",
            "value" : "Voer een nieuwe naam in voor dit gesprek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie einen neuen Namen für diese Unterhaltung ein."
