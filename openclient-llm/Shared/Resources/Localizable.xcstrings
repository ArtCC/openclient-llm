    "This external tool may access, create, change, or delete data and may incur costs." : {
      "comment" : "A description of the impact of using this tool.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "この外部ツールはデータにアクセス、作成、変更、または削除する場合があり、費用が発生する可能性があります。",
