        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαμόρφωση του διακομιστή MCP άλλαξε. Ζητήστε ξανά το εργαλείο πριν το εκτελέσετε."
          }
        },
        "sv" : {
          "stringUnit" : {
