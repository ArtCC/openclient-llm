    "iCloud is downloading changes. Sync will continue automatically." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "value" : "iCloud is wijzigingen aan het ontvangen. Synchronisatie gaat automatisch door.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudが変更を受信しています。同期は自動的に続行されます。"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Το iCloud λαμβάνει αλλαγές. Ο συγχρονισμός θα συνεχιστεί αυτόματα.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud sta ricevendo le modifiche. La sincronizzazione continuerà automaticamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "iCloud lädt Änderungen herunter. Die Synchronisierung wird automatisch fortgesetzt.",
            "state" : "translated"
