    "The model finished responding. Tap to continue." : {
      "comment" : "Text displayed in a notification when the LLM has finished responding.",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello ha terminato la risposta. Tocca per continuare."
          }
        },
        "fr" : {
          "stringUnit" : {
