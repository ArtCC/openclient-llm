    "iCloud is unavailable. Your changes will stay on this device until sync resumes." : {
      "comment" : "A footer for the iCloud sync section.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible. Tus cambios permanecerán en este dispositivo hasta que se reanude la sincronización."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudは利用できません。同期が再開されるまで、変更はこのデバイスに保存されます。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud är otillgängligt. Dina ändringar kommer att finnas kvar på den här enheten tills synkroniseringen återupptas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud non è disponibile. Le tue modifiche rimarranno su questo dispositivo finché la sincronizzazione non riprenderà."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud est indisponible. Vos modifications resteront sur cet appareil jusqu’à la reprise de la synchronisation."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is unavailable. Your changes will remain on this device until syncing resumes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud ist nicht verfügbar. Ihre Änderungen bleiben auf diesem Gerät, bis die Synchronisierung fortgesetzt wird."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iCloud não está disponível. As suas alterações permanecerão neste dispositivo até que a sincronização seja retomada."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iCloud δεν είναι διαθέσιμο. Οι αλλαγές σας θα παραμείνουν σε αυτή τη συσκευή μέχρι να επανέλθει ο συγχρονισμός."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is niet beschikbaar. Je wijzigingen blijven op dit apparaat staan totdat de synchronisatie hervat wordt."
          }
        }
      }
    },
