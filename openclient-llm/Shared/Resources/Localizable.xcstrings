    "Right-click a message to edit, regenerate, branch, or save it as a favourite." : {
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito numa mensagem para editar, regenerar, ramificar ou guardar como favorito."
