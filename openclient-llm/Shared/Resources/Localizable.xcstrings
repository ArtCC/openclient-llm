        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen und halten Sie eine Unterhaltung, um sie anzuheften, umzubenennen oder Tags hinzuzufügen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話を長押しして、ピン留め、名前変更、またはタグの追加を行います。"
