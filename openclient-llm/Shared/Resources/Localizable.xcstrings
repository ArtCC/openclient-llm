          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Définir les instructions pour le comportement de l’assistant dans cette conversation.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
