    "Open the app from Shortcuts, other apps, or a browser using `openclient:\/\/`." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app desde Atajos, otras apps o un navegador usando `openclient:\/\/`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット、他のアプリ、またはブラウザから `openclient:\/\/` を使ってアプリを開く"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
