    "No search tools loaded. Tap \"Load Available Tools\" to fetch them from your server." : {
      "comment" : "A label that appears when there are no search tools available.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cargaron herramientas de búsqueda. Toca \"Cargar herramientas disponibles\" para obtenerlas desde tu servidor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "検索ツールが読み込まれていません。「利用可能なツールを読み込む」をタップしてサーバーから取得してください。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga sökverktyg laddade. Tryck på \"Ladda tillgängliga verktyg\" för att hämta dem från din server."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Nessuno strumento di ricerca caricato. Tocca \"Carica strumenti disponibili\" per recuperarli dal server.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No search tools loaded. Tap \"Load Available Tools\" to fetch them from your server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun outil de recherche chargé. Touchez « Charger les outils disponibles » pour les récupérer depuis votre serveur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Suchwerkzeuge geladen. Tippen Sie auf „Verfügbare Werkzeuge laden“, um sie von Ihrem Server abzurufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχουν φορτωθεί εργαλεία αναζήτησης. Πατήστε «Φόρτωση Διαθέσιμων Εργαλείων» για να τα κατεβάσετε από τον διακομιστή σας."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Nenhuma ferramenta de pesquisa carregada. Toque em \"Carregar Ferramentas Disponíveis\" para as obter do seu servidor.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen zoekhulpmiddelen geladen. Tik op \"Beschikbare hulpmiddelen laden\" om ze van uw server op te halen."
          }
        }
      }
    },
    "Sync could not finish. Your changes remain safely stored on this device." : {
      "comment" : "A description of a failed iCloud sync.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "value" : "La sincronización no pudo completarse. Tus cambios permanecen guardados de forma segura en este dispositivo.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期を完了できませんでした。変更内容はこのデバイスに安全に保存されています。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen kunde inte slutföras. Dina ändringar är säkert sparade på den här enheten."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "La sincronizzazione non è riuscita. Le tue modifiche sono comunque salvate in modo sicuro su questo dispositivo.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation n’a pas pu se terminer. Vos modifications restent en sécurité sur cet appareil."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Sync could not complete. Your changes are safely stored on this device.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung konnte nicht abgeschlossen werden. Ihre Änderungen sind sicher auf diesem Gerät gespeichert."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização não pôde ser concluída. As suas alterações permanecem guardadas com segurança neste dispositivo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός δεν ολοκληρώθηκε. Οι αλλαγές σας παραμένουν αποθηκευμένες με ασφάλεια σε αυτή τη συσκευή."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie kon niet worden voltooid. Je wijzigingen zijn veilig opgeslagen op dit apparaat."
          }
        }
      }
    },
