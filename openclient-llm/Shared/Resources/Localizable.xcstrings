        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is downloading changes. Sync will continue automatically."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "O iCloud está a transferir alterações. A sincronização continuará automaticamente.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "iCloud télécharge les modifications. La synchronisation se poursuivra automatiquement.",
